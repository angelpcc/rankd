# Copia este archivo como .env y rellena los valores.
# .env está en .gitignore: NUNCA se sube al repositorio.

# ── Supabase (frontend) ──
# Panel de Supabase → Project Settings → API
# El prefijo VITE_ hace que acaben en el bundle del navegador: aquí van
# SOLO las claves públicas (anon), nunca la service_role.
VITE_PUBLIC_SUPABASE_URL=
VITE_PUBLIC_SUPABASE_ANON_KEY=

# ══════════════════════════════════════════════════════════════
# A PARTIR DE AQUÍ: CLAVES DE SERVIDOR. SIN prefijo VITE_.
# Solo las leen las funciones de /api. Si les pones VITE_ delante,
# acaban publicadas en el navegador.
# ══════════════════════════════════════════════════════════════

# ── IA de Mi Esquina (ver IA.md) ──
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ── Correo (ver EMAILS.md) ──
# https://resend.com → API Keys
RESEND_API_KEY=
# Remitente. Sin dominio verificado, déjalo vacío y usará onboarding@resend.dev
RESEND_FROM=

# ── Envío masivo de correo (ver EMAILS.md) ──
# Supabase → Project Settings → API → service_role
# Se salta TODAS las políticas de seguridad de la base de datos.
SUPABASE_SERVICE_ROLE_KEY=

# ── Dominio propio, cuando lo haya ──
# Se usa para los enlaces dentro de los correos.
SITE_URL=
